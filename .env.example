# Puerto asignado automáticamente por la mayoría de proveedores.
PORT=3000

# Número que se vinculará con WhatsApp, con código de país y solo dígitos.
BOT_NUMBER=529852277382

# Opcional: números propietarios separados por comas.
OWNER_NUMBERS=529852270023,5219852270023

# Usar una ruta de volumen persistente para conservar sesión y datos.
# Ejemplo: BOT_DATA_DIR=/data
# BOT_DATA_DIR=/data
# También se acepta PERSISTENT_DIR=/data si ese es el nombre disponible en el panel.

# Alternativas si el proveedor entrega rutas distintas.
# SESSION_PATH=/data/kurumi_session
# DB_PATH=/data/data/database.json

# La recarga de archivos se deja apagada en producción para ahorrar recursos.
HOT_RELOAD=false
HOT_RELOAD_NOTIFY=false

# Ajustes opcionales.
USE_PAIRING_CODE=true
AUTO_READ=true
AI_ENABLED=true
NSFW_ENABLED=true
# NSFW privado: requiere que cada usuario use !nsfw on antes de solicitar contenido.
NSFW_PRIVATE_ENABLED=true

# Los comandos NSFW usan fuentes gratuitas y respaldos automáticos. No requieren API key.

# Clave de Google Gemini usada por el comando /ia.
# Déjala vacía en esta plantilla. Solo se completa en el archivo privado .env del servidor.
GEMINI_API_KEY=
